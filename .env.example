# 이 파일을 .env.local 로 복사해서 값을 채우세요. (.env.local 은 커밋되지 않습니다)

# API 베이스 URL.
# 비워두면 '/api'가 기본값이며 vite dev 프록시(VITE_DEV_PROXY_TARGET)를 통해 로컬 백엔드로 전달됩니다.
# Capacitor 빌드 시에는 절대 주소가 필요합니다. (예: https://api.example.com)
VITE_API_BASE_URL=

# vite dev 서버가 /api 요청을 넘길 로컬 백엔드 주소
VITE_DEV_PROXY_TARGET=http://localhost:8080

# 카카오 로그인 (카카오 개발자 콘솔 > 앱 키 > REST API 키)
# JavaScript 키가 아니라 REST API 키다 — 인가코드 요청의 client_id로 쓰인다.
# 아래 REDIRECT_URI는 카카오 콘솔의 [카카오 로그인 > Redirect URI]에도 똑같이 등록해야 한다.
VITE_KAKAO_REST_API_KEY=
VITE_KAKAO_REDIRECT_URI=http://localhost:5173/oauth/kakao/callback
